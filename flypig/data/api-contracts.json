{
  "version": "0.1.0",
  "description": "FlyPig REST API 契约定义",
  "contracts": {
    "GET /api/health": {
      "description": "健康检查",
      "response_200": {
        "type": "object",
        "fields": {
          "status": {"type": "string", "example": "ok"},
          "version": {"type": "string", "example": "0.1.0"}
        },
        "required": ["status", "version"]
      }
    },
    "GET /api/ping": {
      "description": "Ping 检查",
      "response_200": {
        "type": "object",
        "fields": {
          "pong": {"type": "boolean", "example": true}
        },
        "required": ["pong"]
      }
    },
    "GET /api/config": {
      "description": "获取应用配置",
      "response_200": {
        "type": "object",
        "fields": {
          "default_model": {"type": "string", "example": "gpt-4"},
          "workspace": {"type": "string", "example": "/home/user/project"},
          "log_level": {"type": "string", "example": "INFO"},
          "models": {"type": "array"},
          "providers": {"type": "object"}
        },
        "required": ["default_model", "workspace", "models", "providers"]
      }
    },
    "PUT /api/config": {
      "description": "更新配置",
      "response_200": {
        "type": "object",
        "fields": {
          "ok": {"type": "boolean", "example": true}
        },
        "required": ["ok"]
      }
    },
    "POST /api/config/apikey": {
      "description": "保存 API Key",
      "response_200": {
        "type": "object",
        "fields": {
          "ok": {"type": "boolean", "example": true}
        },
        "required": ["ok"]
      }
    },
    "POST /api/config/workspace": {
      "description": "设置工作目录",
      "response_200": {
        "type": "object",
        "fields": {
          "workspace": {"type": "string"}
        },
        "required": ["workspace"]
      }
    },
    "POST /api/config/browse": {
      "description": "浏览目录",
      "response_200": {
        "type": "object",
        "fields": {
          "path": {"type": "string"},
          "parent": {"type": ["string", "null"]},
          "entries": {"type": "array"}
        },
        "required": ["path", "parent", "entries"]
      }
    },
    "GET /api/pricing": {
      "description": "获取模型定价",
      "response_200": {
        "type": "object",
        "fields": {
          "prices": {"type": "object"},
          "source": {"type": "string", "example": "cached"},
          "currency": {"type": "string", "example": "USD"}
        },
        "required": ["prices", "source"]
      }
    },
    "POST /api/chat": {
      "description": "发送聊天消息",
      "response_200": {
        "type": "text/event-stream",
        "description": "SSE 流式响应，包含 text-start/text-delta/text-end/finish/error 事件"
      }
    },
    "POST /api/tree": {
      "description": "获取文件树",
      "response_200": {
        "type": "object",
        "fields": {
          "path": {"type": "string"},
          "entries": {"type": "array"}
        },
        "required": ["path", "entries"]
      }
    }
  }
}
